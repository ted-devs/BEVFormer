# Optional: specify custom paths for dataset, checkpoints, and torch model cache
#
# Examples for Windows (separate drive or folder):
# DATA_DIR=E:/datasets/bevformer_data
# CKPTS_DIR=E:/checkpoints/bevformer_ckpts
# TORCH_CACHE=D:/workspace/BEVFormer/.cache/torch
#
# Examples for Linux (dedicated NVMe mount):
# DATA_DIR=/mnt/nvme/data
# CKPTS_DIR=/mnt/nvme/ckpts
# TORCH_CACHE=/mnt/nvme/.cache/torch
#
# If left commented or unset, they default to local folders in the repository:
# DATA_DIR=./data
# CKPTS_DIR=./ckpts
# TORCH_CACHE=./.cache/torch
